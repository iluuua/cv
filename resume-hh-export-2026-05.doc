\pard\intbl\itap1\sl260{\fs18 \uc0\u1054 \uc0\u1062  \uc0\u1057 \uc0\u1080 \uc0\u1088 \uc0\u1080 \uc0\u1091 \uc0\u1089 , \uc0\u1056 \uc0\u1072 \uc0\u1079 \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1082 \uc0\u1072 }
