\pard\intbl\itap1\sl280{\fs24\b \uc0\u1058 -\uc0\u1055 \uc0\u1086 \uc0\u1082 \uc0\u1086 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1040 \uc0\u1083 \uc0\u1075 \uc0\u1086 \uc0\u1088 \uc0\u1080 \uc0\u1090 \uc0\u1084 \uc0\u1099  - \uc0\u1055 \uc0\u1072 \uc0\u1088 \uc0\u1072 \uc0\u1083 \uc0\u1083 \uc0\u1077 \uc0\u1083 \uc0\u1100  B}\par
